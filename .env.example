# Copy these public values into backend/config.js for this static-site setup.
# Only use the project URL and anon/publishable key. Never expose a service-role key.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
CONTACT_ENDPOINT=

# Server-only Resend settings belong in Supabase Edge Function secrets,
# never in the browser or this frontend configuration:
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=
# CONTACT_TO_EMAIL=mayanksaini1072007@gmail.com
# CONTACT_ALLOWED_ORIGINS=https://your-deployed-domain.example
# CONTACT_RATE_LIMIT_SALT=long-random-server-only-value
